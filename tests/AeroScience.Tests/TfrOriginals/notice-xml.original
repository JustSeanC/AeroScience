          &lt;TD colspan="5" valign="top"&gt;
            &lt;font face="Arial" size="2"&gt;From October 27, 2026 at 1600 UTC (October 27, 2026 at 1100 CDT)&lt;/font&gt;
          &lt;/TD&gt;
        &lt;/TR&gt;
        &lt;TR&gt;
          &lt;TD&gt; &lt;/TD&gt;
          &lt;TD&gt; &lt;/TD&gt;
          &lt;TD colspan="5" valign="top"&gt;
            &lt;font face="Arial" size="2"&gt;To October 27, 2026 at 2230 UTC (October 27, 2026 at 1730 CDT)&lt;/font&gt;
          &lt;/TD&gt;
