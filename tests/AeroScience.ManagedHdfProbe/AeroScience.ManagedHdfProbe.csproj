<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="PureHDF" Version="2.2.0" /></ItemGroup>
  <ItemGroup><None Update="synthetic*.nc" CopyToOutputDirectory="PreserveNewest" /><None Update="emit-fixture-provenance.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
