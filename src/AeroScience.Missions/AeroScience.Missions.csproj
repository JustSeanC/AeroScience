<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="GeographicLib.NET" Version="2.3.2" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <ProjectReference Include="../AeroScience.Shared/AeroScience.Shared.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <PropertyGroup>
    <LidarBuildDirectory>$(MSBuildProjectDirectory)/obj/native-lidar/$(Configuration)/$(RuntimeIdentifier)</LidarBuildDirectory>
    <LidarExecutable>AeroScience.LidarReader</LidarExecutable>
    <LidarExecutable Condition="$([MSBuild]::IsOSPlatform('Windows'))">AeroScience.LidarReader.exe</LidarExecutable>
    <LidarPython>python3</LidarPython>
    <LidarPython Condition="$([MSBuild]::IsOSPlatform('Windows'))">python</LidarPython>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(LidarBuildDirectory)/LidarRuntimeIdentity.g.cs" />
    <None Include="$(LidarBuildDirectory)/$(LidarExecutable)" Link="LidarRuntime/$(LidarExecutable)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(LidarBuildDirectory)/LASzip.txt" Link="LidarRuntime/LASzip.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildVerifiedLidarRuntime" BeforeTargets="CoreCompile;GetCopyToOutputDirectoryItems">
    <Exec Command="$(LidarPython) &quot;$(MSBuildThisFileDirectory)../../scripts/build/lidar_runtime.py&quot; --output &quot;$(LidarBuildDirectory)&quot;" />
  </Target>
</Project>
