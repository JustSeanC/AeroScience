<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AeroScience</AssemblyName>
    <ApplicationIcon>../AeroScience.Engine/wwwroot/branding/aeroscience.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../AeroScience.Engine/wwwroot/branding/aeroscience.ico" LogicalName="AeroScience.Branding.Icon" />
    <EmbeddedResource Include="../AeroScience.Engine/wwwroot/branding/primary-64.png" LogicalName="AeroScience.Branding.Primary" />
    <ProjectReference Include="../AeroScience.Engine/AeroScience.Engine.csproj" />
    <Content Include="../AeroScience.Engine/wwwroot/**" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/**" Link="wwwroot/help/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../README.md;../../INSTALL.md;../../CHANGELOG.md;../../THIRD-PARTY-NOTICES.md" Link="wwwroot/help/_root/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="wwwroot/help/_root/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/**" Link="wwwroot/help/_root/licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
