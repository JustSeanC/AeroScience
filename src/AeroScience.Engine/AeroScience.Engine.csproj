<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><RuntimeIdentifiers>win-x64</RuntimeIdentifiers></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AeroScience.Shared/AeroScience.Shared.csproj" />
    <ProjectReference Include="../AeroScience.Telemetry/AeroScience.Telemetry.csproj" />
    <ProjectReference Include="../AeroScience.Missions/AeroScience.Missions.csproj" />
    <ProjectReference Include="../AeroScience.SimConnect/AeroScience.SimConnect.csproj" />
  </ItemGroup>
  <ItemGroup><Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <Content Include="../../docs/**" Link="wwwroot/help/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../README.md;../../INSTALL.md;../../CHANGELOG.md;../../THIRD-PARTY-NOTICES.md" Link="wwwroot/help/_root/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="wwwroot/help/_root/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../licenses/**" Link="wwwroot/help/_root/licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/OurAirports.txt" Link="licenses/OurAirports.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/LibTiff.NET.txt" Link="licenses/LibTiff.NET.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/NetTopologySuite.txt" Link="licenses/NetTopologySuite.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
